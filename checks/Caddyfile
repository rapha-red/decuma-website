# Local serving of the built tree for the browser checks: addresses without ".html" and without a trailing slash, as
# on the server. SITE_ROOT and SITE_PORT come from the caller.
{
	admin off
	auto_https off
	persist_config off
}
http://127.0.0.1:{$SITE_PORT:8099} {
	root * {$SITE_ROOT}
	# the production Content-Security-Policy of the site block on the server (keep equal), so every browser check runs under it
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	try_files {path}.html {path}/index.html {path}
	file_server
	handle_errors {
		@en path /en/*
		rewrite @en /en/404.html
		rewrite * /404.html
		file_server
	}
	log {
		output discard
	}
}
