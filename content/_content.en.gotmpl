{{/* Pages that exist only while their flag is on in data/offer.json: added here instead of a file, so that a flag flip
     plus a build is the only change when the capability goes live. English slugs; German in _content.gotmpl. */}}
{{ range slice (slice "bots" "agent_tier" "bots" "bots" false) (slice "open-source" "source_link" "open-source" "product" false) }}
  {{ if or (index hugo.Data.offer.flags (index . 1)) (and site.Params.show_all_flags (not (in site.Params.real_flags (index . 1)))) }}
    {{ $p := dict "path" (index . 0) "kind" "page" "params" (dict "translationKey" (index . 2) "flag" (index . 1)) }}
    {{ $p = merge $p (dict "layout" (index . 3) "draft" (index . 4)) }}
    {{ $.AddPage $p }}
  {{ end }}
{{ end }}
