{{/* Pages that exist only while their flag is on in data/offer.json: added here instead of a file, so that a flag flip
     plus a build is the only change when the capability goes live. English slugs; German in _content.gotmpl. */}}
{{ range slice (slice "bots" "agent_tier") (slice "open-source" "source_link") }}
  {{ if index hugo.Data.offer.flags (index . 1) }}
    {{ $.AddPage (dict "path" (index . 0) "kind" "page" "params" (dict "translationKey" (index . 0) "flag" (index . 1))) }}
  {{ end }}
{{ end }}
